# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# Everything here comes from the two services you create in module 01.

# ---------------------------------------------------------------------------
# ClickHouse Managed Postgres  (Console → Postgres → your service → Connect)
# ---------------------------------------------------------------------------
PGHOST=your-service-abcdef12.xxxxxxxx.c0.us-east-1.aws.pg.clickhouse.cloud
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
PGSSLMODE=require

# ---------------------------------------------------------------------------
# ClickHouse Cloud  (Console → your service → Connect → HTTPS)
# Needed from module 03 on: ClickHouse is what fetches the feed. Port 8443 is
# the HTTPS interface.
# ---------------------------------------------------------------------------
CH_HOST=your-service.us-east-1.aws.clickhouse.cloud
CH_PORT=8443
CH_USER=default
CH_PASSWORD=
# ny_citibike, NOT the 'default' the Connect screen shows. Module 03 creates it,
# and it is named to match the Postgres schema on purpose — see below.
CH_DATABASE=ny_citibike

# ---------------------------------------------------------------------------
# One name on both sides
# ---------------------------------------------------------------------------
# The Postgres schema and the ClickHouse database are both `ny_citibike`. The
# same object therefore has the same qualified name wherever it lives, which is
# what makes "which engine answered?" a question about the plan rather than a
# question about which name you happened to type.
#
# One derived name keeps the boundary visible, and it is local:
#
#   ny_citibike          the real Postgres schema, and the ClickHouse database
#   ny_citibike_ch       foreign tables — ClickHouse, seen from inside Postgres
#
LOCAL_SCHEMA=ny_citibike
# Stays empty until module 06 imports it; the dashboard then gains a
# Postgres/ClickHouse switch on its own.
FOREIGN_SCHEMA=
UI_PORT=8080

# ---------------------------------------------------------------------------
# The data feed is NOT configured here
# ---------------------------------------------------------------------------
# ClickHouse fetches it, so the URL lives in the refreshable materialized view
# that does the fetching — the two url() calls in clickhouse/01-ingest-rmv.sql.
# To point the workshop at another city, edit those and re-run the file.
#
# Any docked system in the GBFS registry works — over 1,500 of them, none
# requiring a key:  https://github.com/MobilityData/gbfs/blob/master/systems.csv
