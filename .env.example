# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# Everything here comes from the two services you create in module 01.

# ---------------------------------------------------------------------------
# ClickHouse Managed Postgres  (Console → Postgres → your service → Connect)
# ---------------------------------------------------------------------------
PGHOST=your-service-abcdef12.xxxxxxxx.c0.us-east-1.aws.pg.clickhouse.cloud
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
PGSSLMODE=require

# ---------------------------------------------------------------------------
# ClickHouse Cloud  (Console → your service → Connect → HTTPS)
# Only needed from module 04 onward. Port 8443 is the HTTPS interface.
# ---------------------------------------------------------------------------
CH_HOST=your-service.us-east-1.aws.clickhouse.cloud
CH_PORT=8443
CH_USER=default
CH_PASSWORD=
CH_DATABASE=default

# ---------------------------------------------------------------------------
# The data feed
# ---------------------------------------------------------------------------
# Auto-discovery entry point, not a data file. The collector follows it to the
# real URLs, which for Citi Bike live on a different host (gbfs.lyft.com).
#
# Any docked system from the GBFS registry works. Pick one near you:
#   https://github.com/MobilityData/gbfs/blob/master/systems.csv
#
#   Capital Bikeshare  https://gbfs.lyft.com/gbfs/2.3/dca-cabi/gbfs.json
#   Bay Wheels         https://gbfs.lyft.com/gbfs/2.3/bay/gbfs.json
#   Vélib' (Paris)     https://velib-metropole-opendata.smovengo.cloud/opendata/Velib_Metropole/gbfs.json
GBFS_URL=https://gbfs.citibikenyc.com/gbfs/2.3/gbfs.json
GBFS_LANG=en

# Seconds between snapshots. 60 matches the feed's own ttl; going faster just
# records the same snapshot twice. At 60s Citi Bike yields ~3.6M rows/day.
POLL_SECONDS=60

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
# Which schema the Statistics tab reads. Leave as-is until module 05 has
# imported the foreign schema, then the dashboard gains a Postgres/ClickHouse
# switch on its own.
LOCAL_SCHEMA=bike
FOREIGN_SCHEMA=
UI_PORT=8080
